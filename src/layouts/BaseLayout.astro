---
/**
 * 全站基础布局
 * - 负责 <head> 的 SEO / 主题初始化 / 全局样式
 * - 主题在首屏前由内联脚本写入 <html data-theme>,避免闪烁(FOUC)
 */
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 页面主体附加 class */
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : `${site.name} - ${site.tagline}`;

// 只有在 astro.config.mjs 配置了正式域名(或构建时设置 SITE_URL)时,
// 才输出 canonical / og:url / og:image —— 避免把占位域名发布上线。
const siteUrl = Astro.site;
const hasRealSite = Boolean(siteUrl) && !siteUrl!.hostname.endsWith('example.com');
const canonicalURL = hasRealSite ? new URL(Astro.url.pathname, siteUrl) : null;
const ogImageURL = hasRealSite ? new URL('/app.png', siteUrl).href : null;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta name="baidu-site-verification" content={site.baiduVerify} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070a12" />

    {/* 主题初始化:必须内联且同步,避免深色主题闪白 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // 标记 JS 可用:滚动入场动画仅在此前提下生效
        root.classList.add('js');

        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {
          /* 隐私模式下 localStorage 可能不可用 */
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <slot />

    <script>
      // ---- 主题切换 ----
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      // 保持 aria-pressed 与当前主题同步,便于读屏用户理解按钮状态
      const syncToggle = () => {
        toggle?.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
      };
      syncToggle();

      toggle?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* 忽略写入失败 */
        }
        syncToggle();
      });

      // ---- 页头滚动状态 ----
      const header = document.querySelector('.site-header');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // ---- 滚动入场动画 ----
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }

      // ---- 页脚年份 ----
      document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>
  </body>
</html>
