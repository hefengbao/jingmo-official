---
/**
 * 页头导航
 * variant: 'home' 展示首页锚点导航与下载按钮;'doc' 仅保留品牌与主题切换
 * (品牌 logo 本身仍是回首页的入口)
 */
import { nav, links, site } from '../data/site';

interface Props {
  variant?: 'home' | 'doc';
}

const { variant = 'home' } = Astro.props;
const items = variant === 'home' ? nav : [];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <img class="brand__logo" src="/logo.png" alt="" width="38" height="38" />
      <span class="brand__name">
        <span>{site.name}</span>
        <small>{site.enName}</small>
      </span>
    </a>

    {
      items.length > 0 && (
        <nav class="nav" aria-label="主导航">
          {items.map((item) => (
            <a class="nav__link" href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
        </svg>
      </button>

      {
        variant === 'home' && (
          <a class="btn btn--primary btn--sm" href={links.download} download={links.downloadFileName}>
            立即下载
          </a>
        )
      }
    </div>
  </div>
</header>
