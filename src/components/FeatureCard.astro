---
/** 功能展示卡片:图片 + 渐变遮罩文案 */
import type { Feature } from '../data/site';

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
---

<article class="card feature-card reveal">
  <div class="feature-card__media">
    <img src={feature.img} alt={feature.alt} loading="lazy" decoding="async" />
    <div class="feature-card__overlay">
      <h3 class="feature-card__title">{feature.title}</h3>
      <p class="feature-card__desc">{feature.desc}</p>
    </div>
  </div>
</article>
